# Copy to .env and enter your actual MySQL credentials. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pokedex_app
DB_USER=
DB_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Set true only behind one trusted HTTPS reverse proxy in production.
TRUST_PROXY=false

# Optional private Owner-only GBA library. Development + loopback only.
DEXHAVEN_ENABLE_GBA=false
DEXHAVEN_GBA_ROMS_DIR=./Dexhaven-GBA/ROMs
