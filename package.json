{
  "name": "kanto-pokedex-app",
  "version": "0.5.0",
  "private": true,
  "description": "Pokédex Website project — Dexhaven National Pokédex and Pokémon analytics, Generations I–V",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:setup": "node server/setup-db.js",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-qa.cjs",
    "data:update": "node scripts/update-pokemon-data.cjs",
    "vendor:chart": "node scripts/vendor-chart.cjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "chart.js": "4.6.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "sharp": "^0.35.5"
  }
}
