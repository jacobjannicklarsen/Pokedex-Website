{
  "name": "kanto-pokedex-app",
  "version": "0.7.2",
  "private": true,
  "description": "Pokédex Website project — Dexhaven National Pokédex and Pokémon analytics, Generations I–V",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:setup": "node server/setup-db.js",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-qa.cjs",
    "test:firefox": "node tests/firefox-card-qa.cjs",
    "sprites:verify": "node scripts/verify-sprites.cjs",
    "data:update": "node scripts/update-pokemon-data.cjs",
    "vendor:chart": "node scripts/vendor-chart.cjs",
    "admin:bootstrap": "node scripts/bootstrap-owner.cjs",
    "data:battle": "node scripts/update-battle-data.cjs",
    "vendor:battle": "node scripts/vendor-battle-simulator.cjs",
    "vendor:emulator": "node scripts/vendor-emulator.cjs",
    "build:preview": "node scripts/build-static-preview.cjs"
  },
  "dependencies": {
    "@pkmn/sim": "0.10.11",
    "argon2": "^0.45.1",
    "chart.js": "4.6.1",
    "dotenv": "^17.2.0",
    "esbuild": "0.25.12",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "sharp": "^0.35.5"
  }
}
